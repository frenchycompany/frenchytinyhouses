---
import InvestorLayout from '../../layouts/InvestorLayout.astro';
import KpiBlock from '../../components/KpiBlock.astro';
import mock from '../../data/investor-mock.json';

const k = mock.kpis;
const fmtEur = (n: number) => new Intl.NumberFormat('fr-FR').format(n) + ' €';

// Project lat/lng (France ~ 41–51°N, -5–10°E) onto an SVG box (0..600, 0..640).
function project(lat: number, lng: number) {
  const minLat = 41, maxLat = 51.5;
  const minLng = -5.5, maxLng = 10;
  const x = ((lng - minLng) / (maxLng - minLng)) * 600;
  const y = ((maxLat - lat) / (maxLat - minLat)) * 640;
  return { x, y };
}

const statusColor: Record<string, string> = {
  installed: '#4a6b3a',
  contracted: '#b8924a',
  pipeline: '#d4b06a',
};

const statusLabel: Record<string, string> = {
  installed: 'Installée',
  contracted: 'Contrat signé',
  pipeline: 'En pipeline',
};

const fmtRel = (iso: string) => {
  const diff = (Date.now() - new Date(iso).getTime()) / 86400000;
  if (diff < 1) return 'aujourd\'hui';
  if (diff < 2) return 'hier';
  if (diff < 7) return `il y a ${Math.floor(diff)} jours`;
  if (diff < 30) return `il y a ${Math.floor(diff / 7)} semaines`;
  return `il y a ${Math.floor(diff / 30)} mois`;
};
---
<InvestorLayout
  title="Dashboard opérationnel — Frenchy Tiny Houses"
  description="Suivi en temps réel des unités installées, contrats, pipeline et revenu cumulé."
  num="— 02 / 03"
>
  <section class="mx-auto max-w-page px-6 pt-10 pb-6">
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-4">
      <div>
        <h1 class="font-serif text-4xl md:text-5xl text-dark leading-tight">
          Dashboard opérationnel
        </h1>
        <p class="mt-3 text-[15px] text-ink/70">
          Données mock — Phase 1. Bascule sur la production en Phase 5+.
        </p>
      </div>
      <div class="flex items-center gap-2 self-start md:self-end">
        <span class="inline-block w-2 h-2 rounded-full bg-leaf animate-pulse"></span>
        <span class="font-mono text-[10px] uppercase tracking-widest text-ink/70">
          Mise à jour {mock.asOf}
        </span>
      </div>
    </div>
  </section>

  <!-- KPIs -->
  <section class="border-y border-line bg-paper/60">
    <div class="mx-auto max-w-page px-6 py-12 grid gap-8 md:grid-cols-4">
      <KpiBlock value={String(k.unitsInstalled)} label="Installées" />
      <KpiBlock value={String(k.unitsContracted)} label="Contrats signés" />
      <KpiBlock value={String(k.unitsInPipeline)} label="En pipeline" />
      <KpiBlock value={fmtEur(k.revenueYtdEur)} label="Revenu cumulé YTD" />
    </div>
  </section>

  <section class="mx-auto max-w-page px-6 py-16 grid gap-12 md:grid-cols-12">
    <!-- MAP -->
    <div class="md:col-span-7">
      <p class="section-num">— Déploiement</p>
      <h2 class="mt-3 font-serif text-2xl text-dark">Carte de France</h2>

      <div class="mt-6 border border-gold/30 bg-paper p-6">
        <svg viewBox="0 0 600 640" class="w-full h-auto" role="img" aria-label="Carte des unités déployées">
          <!-- Hexagonal France placeholder (très stylisé) -->
          <path
            d="M 295 30 L 480 100 L 540 280 L 510 480 L 380 600 L 200 590 L 90 460 L 70 260 L 150 100 Z"
            fill="#f4f1ec"
            stroke="#d8cfbf"
            stroke-width="1.5"
          />
          {mock.units.map((u) => {
            const { x, y } = project(u.lat, u.lng);
            return (
              <g>
                <circle cx={x} cy={y} r="9" fill={statusColor[u.status]} fill-opacity="0.25" />
                <circle cx={x} cy={y} r="5" fill={statusColor[u.status]} />
                <text x={x + 12} y={y + 4} font-family="DM Mono, monospace" font-size="11" fill="#2b2b2b">
                  {u.id} · {u.city}
                </text>
              </g>
            );
          })}
        </svg>

        <div class="mt-6 flex flex-wrap gap-6 text-xs font-mono uppercase tracking-widest">
          <span class="flex items-center gap-2">
            <span class="inline-block w-3 h-3 rounded-full" style={`background:${statusColor.installed}`}></span>
            Installée
          </span>
          <span class="flex items-center gap-2">
            <span class="inline-block w-3 h-3 rounded-full" style={`background:${statusColor.contracted}`}></span>
            Contrat signé
          </span>
          <span class="flex items-center gap-2">
            <span class="inline-block w-3 h-3 rounded-full" style={`background:${statusColor.pipeline}`}></span>
            Pipeline
          </span>
        </div>
      </div>
    </div>

    <!-- FUNNEL + ACTIVITY -->
    <div class="md:col-span-5 space-y-12">
      <div>
        <p class="section-num">— Funnel</p>
        <h2 class="mt-3 font-serif text-2xl text-dark">Conversion</h2>
        <ul class="mt-6 space-y-3">
          {mock.funnel.map((step, i) => {
            const max = mock.funnel[0].value;
            const pct = (step.value / max) * 100;
            return (
              <li>
                <div class="flex items-baseline justify-between gap-4">
                  <span class="label-mono">{String(i + 1).padStart(2, '0')} · {step.label}</span>
                  <span class="font-serif text-xl text-dark">{step.value}</span>
                </div>
                <div class="mt-2 h-1 bg-line">
                  <div class="h-1 bg-gold" style={`width:${pct}%`}></div>
                </div>
              </li>
            );
          })}
        </ul>
      </div>

      <div>
        <p class="section-num">— Activité récente</p>
        <h2 class="mt-3 font-serif text-2xl text-dark">Feed</h2>
        <ul class="mt-6 space-y-4">
          {mock.activity.map((a) => (
            <li class="border-l-2 border-gold pl-4">
              <p class="font-mono text-[10px] uppercase tracking-widest text-ink/60">
                {fmtRel(a.ts)}
              </p>
              <p class="mt-1 text-[14px] text-ink/85">{a.label}</p>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-page px-6 pb-24">
    <div class="border border-gold/30 bg-paper p-8">
      <p class="section-num">— Méthodologie</p>
      <p class="mt-3 text-[14px] leading-relaxed text-ink/80 max-w-prose">
        Phase 1 : données mock, structure de la dataviz validée. Phase 5+ :
        bascule sur la base de production, alimentée par la zone gestion des
        propriétaires (synchro Airbnb / Booking, virements, maintenance).
        Aucun chiffre affiché ici n'est officiel à ce stade.
      </p>
    </div>
  </section>
</InvestorLayout>
