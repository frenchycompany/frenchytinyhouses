---
interface Props {
  value: string;
  label: string;
  note?: string;
}
const { value, label, note } = Astro.props;
---
<div class="border-t border-gold/40 pt-6">
  <p class="font-serif text-4xl md:text-5xl text-dark leading-none">{value}</p>
  <p class="mt-3 label-mono">{label}</p>
  {note && <p class="mt-2 text-xs text-ink/60 italic">{note}</p>}
</div>
