# Frenchy Tiny Houses — variables locales (non sensibles)
# Copier vers .env.local et remplir. .env.local n'est PAS commité.
# Les secrets de prod (clés SSH, mdp DB) ne vivent jamais ici — voir CLAUDE.md §11.

# Site
PUBLIC_SITE_URL=https://frenchytinyhouses.fr
PUBLIC_INVEST_URL=https://invest.frenchytinyhouses.fr

# Formulaires Tally — IDs publics (sécurité gérée côté Tally)
PUBLIC_TALLY_CONTACT_ID=
PUBLIC_TALLY_SIMULATEUR_FOLLOWUP_ID=

# Analytics Umami self-hosted
PUBLIC_UMAMI_SCRIPT_URL=
PUBLIC_UMAMI_WEBSITE_ID=
